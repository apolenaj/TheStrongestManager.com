{
  "name": "thestrongestmanager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:exercises": "npx tsx src/domain/exercises/seed-priority.ts",
    "db:seed:demo": "npx tsx src/domain/demo/seed-cli.ts",
    "db:seed:programs": "npx tsx src/domain/program-catalog/seed-cli.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.27.0",
    "next": "15.5.20",
    "next-auth": "^5.0.0-beta.25",
    "pdfkit": "^0.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
