# Public site URL (used for metadata / canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (SQLite for local; switch provider in prisma/schema for Postgres)
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Staff admin: set User.isAdmin=true in the database for ops accounts.
# Never expose admin UI in athlete navigation; /app/admin uses requireAdmin().

# Optional email delivery for password reset (Resend)
# Without this, reset links are logged in development only
RESEND_API_KEY=
EMAIL_FROM="TheStrongestManager <onboarding@resend.dev>"

# Optional social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# Allow /design-system in production builds (default: development only)
ALLOW_DESIGN_SYSTEM=false

# Feature flags — set to "true" to enable. Default: off / hidden from nav.
# Public modules
NEXT_PUBLIC_FF_COMPARE=true
NEXT_PUBLIC_FF_HISTORY=true
NEXT_PUBLIC_FF_FIT=true
NEXT_PUBLIC_FF_EXERCISE_DETAIL=false
NEXT_PUBLIC_FF_METHOD_DETAIL=true

# Authenticated modules (beyond core Performance OS shells)
NEXT_PUBLIC_FF_APP_EXERCISES=false
NEXT_PUBLIC_FF_APP_METHODS=true
NEXT_PUBLIC_FF_APP_COACH=true
NEXT_PUBLIC_FF_APP_ACADEMY=true
NEXT_PUBLIC_FF_PROGRAM_DETAIL=false
NEXT_PUBLIC_FF_APP_INSIGHTS=true

# Billing checkout — keep false until Stripe keys + price IDs + ready adapter exist
NEXT_PUBLIC_FF_BILLING_CHECKOUT=false

# Central list prices (cents). UI reads these via the billing catalog — do not hard-code in components.
# PRICING_PRO_MONTHLY_CENTS=1900
# PRICING_PRO_ANNUAL_CENTS=19000
# PRICING_PERFORMANCE_MONTHLY_CENTS=3900
# PRICING_PERFORMANCE_ANNUAL_CENTS=39000

# Stripe (server-only; unused until adapter status=ready)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Webhook route: POST /api/billing/webhook — rejects unsigned payloads; 503 if secret unset.
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_PERFORMANCE_MONTHLY=
# STRIPE_PRICE_PERFORMANCE_ANNUAL=

# Optional technique credit packs
# STRIPE_PRICE_CREDITS_5=
# STRIPE_PRICE_CREDITS_20=

# Mealnexio sync — keep false until a real Mealnexio API client exists
NEXT_PUBLIC_FF_MEALNEXIO_SYNC=false
# Coach marketplace browse listings — keep false until real published coaches exist
# Public coach marketplace — browse + consultation requests (default on; never invents coaches)
NEXT_PUBLIC_FF_COACH_MARKETPLACE=true
# Weak Point Intelligence — evidence-backed findings (default on)
NEXT_PUBLIC_FF_WEAK_POINT_INTELLIGENCE=true
# Technique Trend Engine — longitudinal scores (default on)
NEXT_PUBLIC_FF_TECHNIQUE_TREND_ENGINE=true
# Side-by-side video comparison (default on)
NEXT_PUBLIC_FF_VIDEO_COMPARISON=true
# Exercise prescription — multi-rule catalog recommendations (default on)
NEXT_PUBLIC_FF_EXERCISE_PRESCRIPTION=true
# PR Prediction Engine — conservative estimated 1RM ranges (default on)
NEXT_PUBLIC_FF_PR_PREDICTION=true
# Goal Probability Engine — qualitative trajectory, never a fake % (default on)
NEXT_PUBLIC_FF_GOAL_PROBABILITY=true
# Competition Mode — meet prep; never auto weight-cut protocols (default on)
NEXT_PUBLIC_FF_COMPETITION_MODE=true
# Powerlifting Attempt Selector — never guarantees a make (default on)
NEXT_PUBLIC_FF_ATTEMPT_SELECTOR=true
# Personal Record Intelligence — typed PRs + sharing (default on)
NEXT_PUBLIC_FF_PR_INTELLIGENCE=true
# Optional public athlete profiles /u/[slug] — private by default (default on)
NEXT_PUBLIC_FF_PUBLIC_ATHLETE_PROFILE=true
# Opt-in leaderboards — no fake ranks (default on)
NEXT_PUBLIC_FF_LEADERBOARDS=true
# Verified Lift System — never officially verified without criteria (default on)
NEXT_PUBLIC_FF_VERIFIED_LIFTS=true
# Challenge Engine — consistency/learning/improvement; no max-lift races (default on)
NEXT_PUBLIC_FF_CHALLENGE_ENGINE=true
# Achievement System — meaningful milestones only (default on)
NEXT_PUBLIC_FF_ACHIEVEMENT_SYSTEM=true
# Optional Athlete Level — multi-factor; Elite not from app usage (default on)
NEXT_PUBLIC_FF_ATHLETE_LEVEL=true
# Community Knowledge Q&A — AI summarizes only, never impersonates (default on)
NEXT_PUBLIC_FF_COMMUNITY_QA=true
# Expert Contributor — explicit verification; never auto-label (default on)
NEXT_PUBLIC_FF_EXPERT_CONTRIBUTOR=true
# Coach Matching Engine — organic fit; sponsored labeled separately (default on)
NEXT_PUBLIC_FF_COACH_MATCHING=true
# Coach AI Copilot — drafts only; coach Accept/Edit/Reject (default on)
NEXT_PUBLIC_FF_COACH_AI_COPILOT=true
# Multi-athlete coach dashboard — prioritized attention queue (default on)
NEXT_PUBLIC_FF_MULTI_ATHLETE_COACH_DASHBOARD=true
# Gym / team org dashboard — aggregates only; no private data bypass (default on)
NEXT_PUBLIC_FF_GYM_TEAM_DASHBOARD=true
# Organization B2B billing — seats/usage/upgrade; prices via env only (default on)
NEXT_PUBLIC_FF_ORG_BILLING=true
# White-label readiness — architecture only; no custom domain product (default OFF)
NEXT_PUBLIC_FF_WHITE_LABEL=false
# Internationalization — English active; CS/DE/ES/AR planned; no auto fitness terms (default on)
NEXT_PUBLIC_FF_I18N=true
# Unit system — canonical kg/cm/m; kg/lb, cm/ft/in, km/mi presentation (default on)
NEXT_PUBLIC_FF_UNIT_SYSTEM=true
# Timezone system — store UTC; display local for workouts/comps/notifications/messages (default on)
NEXT_PUBLIC_FF_TIMEZONE_SYSTEM=true
# Accessibility 2.0 — WCAG audit; technique scores not color-only (default on)
NEXT_PUBLIC_FF_ACCESSIBILITY_SYSTEM=true
# Performance 2.0 — Core Web Vitals budgets + reporting (default on)
NEXT_PUBLIC_FF_PERFORMANCE_SYSTEM=true
# Database Scale Audit — indexes/N+1/pagination; no premature shard (default on)
NEXT_PUBLIC_FF_DATABASE_SCALE=true
# Event-Driven Architecture — background domain events + queue (default on)
NEXT_PUBLIC_FF_EVENT_DRIVEN_ARCHITECTURE=true
# Production Observability — errors/latency/DB/jobs/payments; correlation IDs (default on)
NEXT_PUBLIC_FF_PRODUCTION_OBSERVABILITY=true
# Backup & Disaster Recovery — runbook registry (default on); see docs/DISASTER_RECOVERY.md
NEXT_PUBLIC_FF_BACKUP_RECOVERY=true
# Billing 2.0 — trials/coupons/grace/invoices/webhook idempotency (default on)
NEXT_PUBLIC_FF_BILLING_2=true
# Entitlement System — central EntitlementService gates (default on)
NEXT_PUBLIC_FF_ENTITLEMENT_SYSTEM=true
# Growth Experiment Framework — homepage CTA / onboarding / pricing only (default on)
NEXT_PUBLIC_FF_GROWTH_EXPERIMENTS=true
# Activation Metrics — onboarding + workout + technique + D7 return (default on)
NEXT_PUBLIC_FF_ACTIVATION_METRICS=true
# Retention Analytics — D1/D7/D30 + subscription/feature; correlation ≠ causation (default on)
NEXT_PUBLIC_FF_RETENTION_ANALYTICS=true
# Conversion Funnel — Homepage → Paid path + drop-offs (default on)
NEXT_PUBLIC_FF_CONVERSION_FUNNEL=true
# User Segmentation — behavior/product context; no sensitive demographics (default on)
NEXT_PUBLIC_FF_USER_SEGMENTATION=true
# Personalized Homepage — traffic intent soft variants; no SEO cloaking (default on)
NEXT_PUBLIC_FF_PERSONALIZED_HOMEPAGE=true
# Programmatic SEO Safety — quality-gated guides; refuse thin page factories (default on)
NEXT_PUBLIC_FF_PROGRAMMATIC_SEO_SAFETY=true
# Exercise Comparison Engine — A vs B dimensions + SEO pairs (default on)
NEXT_PUBLIC_FF_EXERCISE_COMPARISON=true
# Sport Goal Landing Pages — /goals with product CTAs; no SEO filler (default on)
NEXT_PUBLIC_FF_SPORT_GOAL_LANDINGS=true
# Calculator Suite — /tools with precision honesty + product CTAs (default on)
NEXT_PUBLIC_FF_CALCULATOR_SUITE=true
# Free Technique Check Funnel — limited insight before signup; guest video local (default on)
NEXT_PUBLIC_FF_TECHNIQUE_CHECK=true
# Free Program Audit Funnel — paste → deterministic audit; no fake score (default on)
NEXT_PUBLIC_FF_PROGRAM_AUDIT=true
# Free Athlete Assessment — Self-assessment estimate; Not full Athlete Score (default on)
NEXT_PUBLIC_FF_ATHLETE_ASSESSMENT=true
# On-Site Education — Learn why on metrics without leaving the page (default on)
NEXT_PUBLIC_FF_ON_SITE_EDUCATION=true
# Micro-Learning — personalized 1-minute cards; anti-spam max 1/day (default on)
NEXT_PUBLIC_FF_MICRO_LEARNING=true
# Academy 2.0 — learning paths, prerequisites, assignments, knowledge progress (default on)
NEXT_PUBLIC_FF_ACADEMY_20=true
# Certificate verification — public verify by unique ID; never implies accreditation (default on)
NEXT_PUBLIC_FF_CERTIFICATE_VERIFICATION=true
# Enterprise security prep — B2B control registry; never claim unearned compliance certs (default on)
NEXT_PUBLIC_FF_ENTERPRISE_SECURITY=true
# GDPR readiness — consent, export, deletion, cookies, retention; legal pages for counsel review (default on)
NEXT_PUBLIC_FF_GDPR_READINESS=true
# Video privacy controls — private by default; explicit opt-in for expert review / model improvement (default on)
NEXT_PUBLIC_FF_VIDEO_PRIVACY_CONTROLS=true
# Model improvement consent — unbundled service / expert / research UI with revoke (default on)
NEXT_PUBLIC_FF_MODEL_IMPROVEMENT_CONSENT=true
# Safety System 2.0 — central recommendation validator (frequency/volume/weight-loss/diagnosis/pain) (default on)
NEXT_PUBLIC_FF_SAFETY_SYSTEM_20=true
# Red Team AI Coach — adversarial chat QA; refuse unsafe maxes / diagnosis / guarantees (default on)
NEXT_PUBLIC_FF_RED_TEAM_AI_COACH=true
# Product Trust Audit — AI provenance / confidence / certainty / challenge chrome (default on)
NEXT_PUBLIC_FF_PRODUCT_TRUST_AUDIT=true
# Mobile-first workout — one-hand focus, steppers, auto-save, rest timer (default on)
NEXT_PUBLIC_FF_MOBILE_WORKOUT_EXPERIENCE=true
# PWA readiness — installable, offline shell, cached workout, sync; no sensitive SW cache (default on)
NEXT_PUBLIC_FF_PWA_READINESS=true
# Wearable integration architecture — adapter registry; no fake connections (default on)
NEXT_PUBLIC_FF_WEARABLE_INTEGRATION=true
# Per-provider live sync — keep OFF until real clients/credentials exist
NEXT_PUBLIC_FF_WEARABLE_APPLE_HEALTH=false
NEXT_PUBLIC_FF_WEARABLE_GOOGLE_HEALTH_CONNECT=false
NEXT_PUBLIC_FF_WEARABLE_GARMIN=false
NEXT_PUBLIC_FF_WEARABLE_WHOOP=false
NEXT_PUBLIC_FF_WEARABLE_OURA=false
# Device data normalization — canonical sleep/HR/HRV/steps/workouts + cross-device caveats (default on)
NEXT_PUBLIC_FF_DEVICE_DATA_NORMALIZATION=true
# Mealnexio deep linking — outbound CTAs + return landing; no fake SSO/sync (default on)
NEXT_PUBLIC_FF_MEALNEXIO_DEEP_LINKING=true
# Performance OS Command Center — ultimate dashboard shell + widget customize (default on)
NEXT_PUBLIC_FF_COMMAND_CENTER=true
# Custom dashboards — focus presets + smart defaults + save layout (default on)
NEXT_PUBLIC_FF_CUSTOM_DASHBOARDS=true
# Command palette — power-user Ctrl/Cmd+Shift+P (default on; distinct from ⌘K search)
NEXT_PUBLIC_FF_COMMAND_PALETTE=true
# Universal timeline — athlete history + filters (default on)
NEXT_PUBLIC_FF_UNIVERSAL_TIMELINE=true
# Performance Story — yearly narrative + shareable review; no fake causation (default on)
NEXT_PUBLIC_FF_PERFORMANCE_STORY=true
# Year in Review — annual almanac cards + share (default on)
NEXT_PUBLIC_FF_YEAR_IN_REVIEW=true
# Social graph prep — follow/privacy/feed contracts; admin console (default on)
NEXT_PUBLIC_FF_SOCIAL_GRAPH_PREP=true
# Social activity feed — live follower feed (default OFF until moderation ready)
NEXT_PUBLIC_FF_SOCIAL_ACTIVITY_FEED=false
# Activity Feed MVP — optional PRs/competition/achievements/technique; finite; visibility controls (default on)
NEXT_PUBLIC_FF_ACTIVITY_FEED_MVP=true
# Live Competition Mode — meet-day architecture (default on); runtime stays OFF
NEXT_PUBLIC_FF_LIVE_COMPETITION_MODE=true
NEXT_PUBLIC_FF_LIVE_COMPETITION_RUNTIME=false
# Warm-up generator — progressive warm-ups; conservative; editable (default on)
NEXT_PUBLIC_FF_WARMUP_GENERATOR=true
# Session readiness adjuster — pre-workout check-in; never cancel from one metric (default on)
NEXT_PUBLIC_FF_SESSION_READINESS_ADJUSTER=true
# Live session autoregulation — RPE vs planned; suggest reduce next set; confirm required (default on)
NEXT_PUBLIC_FF_LIVE_SESSION_AUTOREGULATION=true
# API platform foundation — no public external API yet (default OFF)
NEXT_PUBLIC_FF_API_PLATFORM=false
# Data moat — privacy-safe aggregation architecture; no live pipeline (default OFF)
NEXT_PUBLIC_FF_DATA_MOAT=false
# Model feedback — helpful/not helpful + coach decisions; no auto-retrain (default on)
NEXT_PUBLIC_FF_MODEL_FEEDBACK=true

# Optional B2B list prices (cents) — leave unset to avoid inventing org dollars
# PRICING_ORG_TEAM_MONTHLY_CENTS=
# PRICING_ORG_TEAM_ANNUAL_CENTS=
# PRICING_ORG_FACILITY_MONTHLY_CENTS=
# PRICING_ORG_FACILITY_ANNUAL_CENTS=
# STRIPE_PRICE_ORG_TEAM_MONTHLY=
# STRIPE_PRICE_ORG_TEAM_ANNUAL=
# STRIPE_PRICE_ORG_FACILITY_MONTHLY=
# STRIPE_PRICE_ORG_FACILITY_ANNUAL=
# Optional seat/usage limit overrides
# ORG_LIMIT_FREE_MAX_COACHES=1
# ORG_LIMIT_FREE_MAX_ATHLETES=5
# ORG_LIMIT_TEAM_MAX_COACHES=5
# ORG_LIMIT_TEAM_MAX_ATHLETES=40

# Product analytics adapter: console | noop (default: console in dev, noop in production)
# ANALYTICS_ADAPTER=noop

# Future Mealnexio API (server-only; unused until adapter is live — do not invent sync)
# MEALNEXIO_API_BASE=
# MEALNEXIO_CLIENT_ID=
# MEALNEXIO_CLIENT_SECRET=
# Future Mealnexio deep-link / SSO (documented only — see docs/MEALNEXIO_DEEP_LINKING.md)
# MEALNEXIO_SSO_ISSUER=
# MEALNEXIO_SSO_CLIENT_ID=
# MEALNEXIO_RETURN_HMAC_SECRET=
# MEALNEXIO_DEEP_LINK_BASE=

# Technique upload pipeline (Prompt 16)
# Optional override for private video directory (default: ./storage/technique)
# TECHNIQUE_STORAGE_DIR=
# Optional signing secret (falls back to AUTH_SECRET)
# TECHNIQUE_MEDIA_SECRET=
# Set to "enabled" only when a real analysis backend is wired — still will not invent scores
# TECHNIQUE_ANALYSIS_BACKEND=
# Optional: browser MediaPipe loads WASM/model from CDN (Prompt 17)
